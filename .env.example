NODE_ENV=development

# --- Database (Supabase) ---
# Transaction-mode pooler (app runtime)
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=1
# Session-mode pooler (Prisma migrations)
DIRECT_URL=postgresql://user:pass@host:5432/postgres

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- Provider result cache (Redis + process fallback), in seconds ---
TRANSPORT_CACHE_TTL_SECONDS=15*60
HOTEL_CACHE_TTL_SECONDS=1800
PLACES_CACHE_TTL_SECONDS=21600
WEATHER_CACHE_TTL_SECONDS=3600

# --- App ---
JWT_SECRET=some-long-random-secret
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
MIN_TRANSFER_MINUTES=90

# --- AI itinerary generation ---
# GROQ | HUGGINGFACE | GEMINI (not implemented) | TEMPLATE (rule-based fallback over real data)
AI_PROVIDER=GROQ
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_...

# Hugging Face Inference Router (OpenAI-compatible) — used when AI_PROVIDER=HUGGINGFACE
HF_TOKEN=hf_...
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:novita

# --- Flights: Sky Scrapper via RapidAPI (https://rapidapi.com/apiheya/api/sky-scrapper) ---
# The free BASIC plan has a monthly request quota; on exhaustion the API returns
# HTTP 429 and flight results are reported as unavailable rather than failing the trip.
SKY_SCRAPPER_RAPIDAPI_KEY=your_rapidapi_key_here
SKY_SCRAPPER_RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# --- Hotels / attractions / restaurants: Google Places API (New) ---
# Enable "Places API (New)" in Google Cloud, set API restrictions + billing alerts.
# Server-side only — never expose this in browser code. Used for search, address,
# rating and coordinates only — photos come from Wikimedia Commons, below.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# How many top hotels get a real coordinate lookup (1 searchText call each).
# Google meters searchText and searchNearby separately, per-day, per project —
# the default cap is 100/day each. Raise it in Google Cloud Console if you hit 429s.
HOTEL_GEOCODE_LIMIT=3
# How long an origin/destination autocomplete response is cached, in seconds.
# Shielding common prefixes ("de", "mum"...) from repeat keystrokes across
# visitors is the point — keep this short since it's a live typeahead, not a
# stable lookup.
PLACES_AUTOCOMPLETE_CACHE_TTL_SECONDS=300

# --- Photos: Wikimedia Commons (no API key required) ---
# Destination, hotel, attraction and restaurant photos go through the API's
# /api/places/photo endpoint, which resolves a Commons file title and redirects
# to Wikimedia's CDN.
# Wikimedia's API etiquette policy asks every client to identify itself — set
# this to something that identifies your deployment, ideally with contact info.
WIKIMEDIA_USER_AGENT=NextTour-TripPlanner/1.0 (https://github.com/nexttour; contact: support@nexttour.app)
# How long a resolved photo URL is cached.
PLACE_PHOTO_CACHE_TTL_SECONDS=3600
# How many top-ranked places per hotel/attraction/restaurant list get a Commons
# photo search. Commons is free and keyless, so this can be larger than
# HOTEL_GEOCODE_LIMIT — the constraint is request latency, not billing.
WIKIMEDIA_PHOTO_LIMIT=12

# --- Buses / trains / hotel rates: RedBus via Playwright ---
# Requires `npm run playwright:install -w @nexttour/api` once after npm install.
# Must be the literal string "true" or "false".
REDBUS_HEADLESS=true
REDBUS_TIMEOUT_MS=45000
REDBUS_HOTEL_TIMEOUT_MS=40000

# --- Shared timeout for REST providers (Sky Scrapper, Google Places, Open-Meteo) ---
EXTERNAL_API_TIMEOUT_MS=15000

# Weather uses Open-Meteo, which needs no API key.
